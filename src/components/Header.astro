---
import { NAV, SITE } from '../config';
import { url } from '../lib/url';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
const normalized = pathname.endsWith('/') ? pathname : `${pathname}/`;

const links = NAV.map((item) => {
  const isHash = item.href.includes('#');
  const target = url(item.href.replace('/#', '/').replace('#', ''));
  const active = !isHash && normalized.startsWith(target);
  return { ...item, active };
});
---

<header class="site-header" id="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={url('/')} aria-label="回到首页">
      <span class="brand-dot" aria-hidden="true"></span>
      <span>{SITE.name}</span>
    </a>

    <nav class="nav" aria-label="主导航">
      {
        links.map((item) => (
          <a
            href={url(item.href)}
            aria-current={item.active ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const sync = () => {
    if (header) header.dataset.scrolled = window.scrollY > 8 ? 'true' : 'false';
  };
  sync();
  window.addEventListener('scroll', sync, { passive: true });
</script>
