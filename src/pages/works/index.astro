---
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getCollection } from 'astro:content';
import { url } from '../../lib/url';

const works = (await getCollection('works', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base title="作品" description="做过的项目、尝试和还没做完的东西。">
  <header class="wrap page-head">
    <p class="mono">Archive</p>
    <h1>作品</h1>
    <p>做过的项目、尝试，和少数做完了的。共 {works.length} 个。</p>
  </header>

  <section class="wrap" style="padding-bottom: clamp(3rem, 8vw, 5rem)">
    {
      works.length > 0 ? (
        <div class="work-grid">
          {works.map((work, i) => (
            <WorkCard
              href={url(`/works/${work.id}/`)}
              title={work.data.title}
              summary={work.data.summary}
              year={work.data.year}
              tags={work.data.tags}
              index={i}
            />
          ))}
        </div>
      ) : (
        <p class="empty">暂时还没有作品。</p>
      )
    }
  </section>
</Base>
